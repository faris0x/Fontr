{
	"schemaVersion": 1,
	"id": "fontr",
	"version": "${version}",
	"name": "Fontr",
	"description": "A global TrueType/OpenType font override for Minecraft 1.8.9. Generates high-resolution font sheets from a TTF/OTF and serves them to every text renderer.",
	"authors": [
		"Faris Alfarhan"
	],
	"contact": {
		"homepage": "https://faris0x.dev",
		"sources": "https://github.com/faris0x/Fontr",
		"issues": "https://github.com/faris0x/Fontr/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/fontr/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.faris0x.fontr.Fontr"
		]
	},
	"mixins": [
		"fontr.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "1.8.9",
		"osl": ">=0.12.0"
	},
	"suggests": {
		"oneconfigv1": ">=1.9.0"
	}
}
